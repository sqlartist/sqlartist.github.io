---
import profile from '../data/profile.json';
interface Props { size?: number }
const { size = 48 } = Astro.props;
const initials = profile.name.split(' ').map((p) => p[0]).join('').slice(0, 2);
---
{profile.avatar
  ? <img class="avatar" src={profile.avatar} alt={profile.name} width={size} height={size} style={`width:${size}px;height:${size}px`} />
  : <span class="avatar avatar-initials" style={`width:${size}px;height:${size}px;font-size:${size * 0.4}px`} aria-label={profile.name}>{initials}</span>}
