---
import '../styles/global.css';
import profile from '../data/profile.json';
import { url } from '../lib';
import SpectrumLoader from '../components/SpectrumLoader.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: 'website' | 'article';
}
const { title, description = profile.tagline, image, canonical, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.siteTitle}`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={profile.name} href={url('/rss.xml')} />
    <meta property="og:title" content={title || profile.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <!-- Visitor stats: https://sqlartist.goatcounter.com (no cookies) -->
    <script is:inline data-goatcounter="https://sqlartist.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={url('/')}>
          <span class="mark" aria-hidden="true">{profile.alias.slice(0, 1).toUpperCase()}</span>
          <span>{profile.siteTitle}</span>
        </a>
        <nav>
          <a href={url('/')} aria-current={path === '/' ? 'page' : undefined}>Stories</a>
          <a href={url('/hypercube/')} aria-current={path.startsWith('/hypercube') ? 'page' : undefined}>Hypercube</a>
          <a href={url('/timeline/')} aria-current={path.startsWith('/timeline') ? 'page' : undefined}>Timeline</a>
          <a href={url('/glossary/')} aria-current={path.startsWith('/glossary') ? 'page' : undefined}>Glossary</a>
          <a href={url('/about/')} aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
          <a href={url('/rss.xml')} title="RSS feed">RSS</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Switch light or dark">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"/></svg>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {profile.name} · <a href={url('/rss.xml')}>RSS</a> · <button type="button" class="zx-hint" data-zx-load title="Or type LOAD &quot;&quot; anywhere">LOAD ""</button></p>
    </footer>
    <SpectrumLoader />
    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>
