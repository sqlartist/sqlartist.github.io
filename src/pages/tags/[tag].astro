---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, tagSlug, type Post } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
interface Props { tag: string; posts: Post[] }
const { tag, posts } = Astro.props;
---
<Base title={tag}>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Topic</p>
      <h1>{tag}</h1>
      <p class="muted">{posts.length} {posts.length === 1 ? 'story' : 'stories'}</p>
    </header>
    <div class="feed">{posts.map((post) => <PostCard post={post} />)}</div>
  </div>
</Base>
